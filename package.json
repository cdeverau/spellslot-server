{
  "name": "spellslot-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "db:local": "wrangler d1 execute spellslot-pool --local --file=schema.sql",
    "db:staging": "wrangler d1 execute spellslot-pool-staging --remote --file=schema.sql --env staging",
    "db:staging:reset": "wrangler d1 execute spellslot-pool-staging --remote --env staging --file=scripts/reset.sql && npm run db:staging",
    "db:clone": "node scripts/clone.mjs",
    "db:remote": "wrangler d1 execute spellslot-pool --remote --file=schema.sql",
    "rollback": "node scripts/rollback.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "wrangler": "^4"
  }
}
